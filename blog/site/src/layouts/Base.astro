---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
}
const { title, description, image = '/bilder/autor.webp', noindex = false, jsonLd = [], type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const fullTitle = Astro.url.pathname === '/' ? `${SITE.name}: Haustechnik einfach erklärt` : `${title} | ${SITE.name}`;
const ogImage = new URL(image, SITE.url).toString();
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Der Handwerksdoktor" href="/rss.xml" />
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#111111" />
  {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="wrap wide">
      <a class="logo" href="/"><img src="/bilder/autor.webp" alt="" width="36" height="36" /><span>Der <b>Handwerksdoktor</b></span></a>
      <nav aria-label="Hauptmenü">
        <a href="/thema/heizung/">Heizung</a>
        <a href="/thema/strom/">Strom</a>
        <a href="/artikel/">Alle Artikel</a>
      </nav>
    </div>
  </header>
  <main id="inhalt">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap wide">
      <p>Als Amazon-Partner verdiene ich an qualifizierten Verkäufen. Links mit * sind Affiliate-Links.</p>
      <nav aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="/werbung/">Transparenz &amp; Werbung</a>
        <a href="/kontakt/">Kontakt</a>
        <a href={SITE.youtube} rel="noopener">YouTube</a>
      </nav>
      <p class="small">© {new Date().getFullYear()} {SITE.author}</p>
    </div>
  </footer>
</body>
</html>
