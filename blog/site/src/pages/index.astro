---
import SuchFeld from '../components/SuchFeld.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArtikelKarte from '../components/ArtikelKarte.astro';
import ArtikelFeature from '../components/ArtikelFeature.astro';
import ArtikelZeile from '../components/ArtikelZeile.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { THEMEN } from '../themen';
import { SAISON, OFT_GELESEN } from '../saison';
import { RECHNER } from '../rechner';
import { CHECKLISTEN } from '../checklisten.mjs';

const posts = (await getCollection('artikel', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const anzahl = (name: string) => posts.filter((p) => p.data.thema === name).length;
const saison = SAISON.artikel.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined);
const neueste = posts.filter((p) => !SAISON.artikel.includes(p.id)).slice(0, 3);
const oftGelesen = OFT_GELESEN.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined);
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/`, inLanguage: 'de-DE' }];
---
<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap wide">
      <h1 class="hero-h" id="hero-h"><span class="line"><span>Haustechnik,</span></span><span class="line"><span>einfach erklärt.</span></span></h1>
    </div>
    <div class="hero-band">
      <div class="hero-band-grid">
        <div class="hero-copy">
          <p class="hero-lead"><span>Warum gluckert die Heizung?</span> <span>Was kostet der Heizlüfter?</span> <span>Wie bekomme ich den Abfluss frei?</span></p>
          <p class="hero-sub">Antworten, die man versteht, und Anleitungen für alles, was du sicher selbst machen kannst.</p>
          <SuchFeld id="suche-start" variante="hero" />
          <div class="hero-cta">
            <a class="btn" href="/artikel/"><Icon name="book-open" size={16} /> Alle Anleitungen</a>
            <a class="btn btn-ghost" href="#themen"><Icon name="compass" size={16} /> Themen</a>
          </div>
        </div>
        <img class="hero-person" src="/bilder/handwerksdoktor-freisteller.webp" alt="Der Handwerksdoktor" width="900" height="900" fetchpriority="high" decoding="async" data-pin-nopin="true" />
        <p class="hero-facts"><span>{posts.length} Anleitungen</span><span>{RECHNER.length} Rechner</span><span>Mit Quellen</span></p>
      </div>
    </div>
  </section>

  <section class="wrap wide saison" aria-labelledby="saison-h">
    <h2 class="section-h" id="saison-h"><Icon name={SAISON.icon} size={26} /> {SAISON.titel}</h2>
    <p class="saison-text">{SAISON.text}</p>
    <div class="feature-grid">
      {saison[0] && <ArtikelFeature post={saison[0]} />}
      <ul class="tiles tiles-liste" aria-label="Weitere Artikel zum Thema">{saison.slice(1).map((p) => <ArtikelZeile post={p} />)}</ul>
    </div>
    <p class="saison-rechner"><a href={SAISON.rechner.href}><Icon name="calculator" size={18} /> {SAISON.rechner.titel}</a></p>
  </section>

  <section class="wrap wide">
    <h2 class="section-h" id="themen">Wobei brauchst du Hilfe?</h2>
    <ul class="tiles">
      {Object.entries(THEMEN).filter(([n]) => anzahl(n) > 0).map(([n, t]) => (
        <li><a href={`/thema/${t.slug}/`} style={`--akzent:${t.farbe}`}>
          <span class="tile-icon"><Icon name={t.icon} size={28} /></span>
          <span class="tile-name">{t.titel}</span>
          <span class="tile-count">{anzahl(n)} {anzahl(n) === 1 ? 'Artikel' : 'Artikel'}</span>
        </a></li>
      ))}
      <li><a href="/rechner/" style="--akzent:#ffd400">
        <span class="tile-icon"><Icon name="calculator" size={28} /></span>
        <span class="tile-name">Rechner</span>
        <span class="tile-count">{RECHNER.length} Rechner für Strom, Heizung, Wasser und mehr</span>
      </a></li>
      <li><a href="/strompreis-heute/" style="--akzent:#3b82f6">
        <span class="tile-icon"><Icon name="clock" size={28} /></span>
        <span class="tile-name">Strompreis heute</span>
        <span class="tile-count">Wann ist Strom heute und morgen am günstigsten?</span>
      </a></li>
      <li><a href="/rechner/balkonkraftwerk/" style="--akzent:#ff741c">
        <span class="tile-icon"><Icon name="sun" size={28} /></span>
        <span class="tile-name">Balkonkraftwerk</span>
        <span class="tile-count">Lohnt sich ein Speicher?</span>
      </a></li>
      <li><a href="/rechner/duebel/" style="--akzent:#12b5a5">
        <span class="tile-icon"><Icon name="brick-wall" size={28} /></span>
        <span class="tile-name">Dübel-Finder</span>
        <span class="tile-count">Welcher Dübel für welche Wand?</span>
      </a></li>
      <li><a href="/checklisten/" style="--akzent:#03b84c">
        <span class="tile-icon"><Icon name="printer" size={28} /></span>
        <span class="tile-name">Checklisten</span>
        <span class="tile-count">{CHECKLISTEN.length} zum Ausdrucken (PDF)</span>
      </a></li>
    </ul>

    <h2 class="section-h">Oft gelesen</h2>
    <ul class="tiles tiles-liste">{oftGelesen.map((p) => <ArtikelZeile post={p} />)}</ul>

    <h2 class="section-h">Neueste Anleitungen</h2>
    <ul class="cards">{neueste.map((p) => <ArtikelKarte post={p} />)}</ul>
    <p class="center"><a class="btn btn-dark" href="/artikel/">Alle {posts.length} Anleitungen ansehen <Icon name="chevron-right" size={18} /></a></p>
  </section>
</Base>
