---
import ArtikelKarte from '../../components/ArtikelKarte.astro';
import { THEMEN } from '../../themen';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('artikel', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Alle Artikel" description="Alle Anleitungen und Erklärungen vom Handwerksdoktor: Heizung, Strom, Wasser, Klima und Küche.">
  <div class="wrap wide">
    <h1>Alle Artikel</h1>
    <ul class="cards">{posts.map((p) => <ArtikelKarte post={p} />)}</ul>
  </div>
</Base>
