---
// Strompreis heute und morgen: alle Viertelstundenpreise der Börse (Day-Ahead, DE-LU) aus src/strompreis-tag.json.
// Die Datei schreibt scripts/strompreise.mjs; der Upload-Workflow läuft nachts und um 12:25 UTC, wenn die Preise für morgen da sind.
import Base from '../layouts/Base.astro';
import Antwort from '../components/Antwort.astro';
import Warnung from '../components/Warnung.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import Tagespreis from '../components/Tagespreis.astro';
import tag from '../strompreis-tag.json';
import { auswerten, endpreis, fmt, datumLang, type Werte } from '../strompreis-auswertung';

const FIX = 16, AUF = 2;  // für den Erklärtext unten; Rechnung in src/strompreis-auswertung.ts
const stand = new Date(tag.stand);
const standText = stand.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
const heuteDe = stand.toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });

const tage = tag.tage.map((t) => ({ ...t, rolle: t.datum === heuteDe ? 'heute' : t.datum > heuteDe ? 'morgen' : 'gestern', ...auswerten(t.werte as [string, number][]) }));
const morgenDa = tage.some((t) => t.rolle === 'morgen');
const heute = tage.find((t) => t.rolle === 'heute') ?? tage[0];

const title = 'Strompreis heute und morgen: Börsenpreis je Viertelstunde';
const description = `Börsenstrompreis ${morgenDa ? 'heute und morgen' : 'heute'} je Viertelstunde: Wann Strom am günstigsten ist, wann am teuersten, und was das im dynamischen Tarif kostet. Täglich aktualisiert aus SMARD-Daten.`;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: `${SITE.url}/strompreis-heute/`, inLanguage: 'de-DE',
  dateModified: tag.stand, description,
  about: { '@type': 'Thing', name: 'Day-Ahead-Strompreis Deutschland' },
}];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap" data-pagefind-body data-pagefind-meta="thema:Tarif">
    <nav class="crumbs" aria-label="Brotkrumen" data-pagefind-ignore><a href="/">Start</a> › <a href="/thema/dynamischer-stromtarif/">Dynamischer Stromtarif</a> › Strompreis heute</nav>
    <h1>Strompreis heute{morgenDa ? ' und morgen' : ''}</h1>
    <p class="lead">Alle Viertelstundenpreise der Strombörse (Day-Ahead, Deutschland), so wie sie dynamische Stromtarife weitergeben. Grün sind die
    günstigsten, rot die teuersten Viertelstunden. Stand: {standText} Uhr.</p>

    {heute && (
      <Antwort>
      <p><strong>Kurz gesagt:</strong> Heute, {datumLang(heute.datum)}, ist Strom an der Börse am günstigsten <strong>{heute.best.text}</strong>
      {' '}(im Schnitt {fmt(heute.best.v)} ct/kWh) und am teuersten <strong>{heute.worst.text}</strong> ({fmt(heute.worst.v)} ct). Tagesmittel
      {' '}<strong>{fmt(heute.mittel)} ct/kWh</strong>{heute.negativ > 0 ? `, ${heute.negativ} Viertelstunden mit negativem Preis` : ''}. Im dynamischen Tarif
      sind das zu Hause etwa <strong>{fmt(endpreis(heute.best.v))} bis {fmt(endpreis(heute.worst.v))} ct/kWh</strong>.</p>
      </Antwort>
    )}

    {tage.map((t) => <Tagespreis datum={t.datum} werte={t.werte as Werte} label={t.rolle === 'heute' ? 'Heute' : t.rolle === 'morgen' ? 'Morgen' : 'Gestern'} />)}

    {!morgenDa && (
      <p class="rc-hinweis"><Icon name="clock" size={15} /> Die Preise für morgen veröffentlicht die Börse täglich gegen 13 Uhr. Diese Seite wird kurz danach
      (etwa 13:30 Uhr im Winter, 14:30 Uhr im Sommer) und jede Nacht neu erzeugt.</p>
    )}

    <p class="sp-nav"><a href="/strompreis-morgen/"><Icon name="calendar-clock" size={16} /> Strompreis morgen</a> <a href="/strompreis/"><Icon name="calendar" size={16} /> Alle Tage seit Oktober 2026</a></p>

    <h2>Was heißt das für dich?</h2>
    <ul>
      <li><strong>Mit dynamischem Tarif:</strong> Zum Börsenpreis kommen rund {FIX} Cent feste Bestandteile netto, der Aufschlag deines Anbieters und
      19 Prozent Mehrwertsteuer. Die Schätzung „zu Hause etwa“ oben rechnet mit {FIX} Cent und {AUF} Cent Aufschlag. Wie das genau geht:
      <a href="/artikel/dynamischer-stromtarif/">Dynamischer Stromtarif: lohnt sich das?</a></li>
      <li><strong>E-Auto</strong> in den grünen Stunden laden, <strong>Waschmaschine und Spülmaschine</strong> per Startzeitvorwahl dorthin legen,
      <strong>Wärmepumpe</strong> den Puffer vorher laden und in den roten Stunden drosseln.</li>
      <li><strong>Mit Festpreis:</strong> Für dich ändert sich nichts, dein Preis bleibt gleich. Ob sich der Wechsel lohnt:
      <a href="/rechner/dynamischer-stromtarif/">Spar-Rechner mit echten Börsenpreisen</a>.</li>
      <li><strong>Negative Preise:</strong> Geld gibt es dafür fast nie, der Strom ist dann aber sehr günstig:
      <a href="/artikel/negative-strompreise/">Negative Strompreise erklärt</a>.</li>
    </ul>

    <Warnung titel="Prognose ist das keine">
    Die Preise für morgen stehen fest, sobald die Börse sie veröffentlicht hat, die für übermorgen kennt niemand. Wie der Tagesverlauf im
    Jahresmittel aussieht, Sommer und Winter getrennt: <a href="/artikel/boersenstrompreis-tagesverlauf/">Börsenstrompreis verstehen</a>.
    </Warnung>

    <h2>Häufige Fragen</h2>
    <h3>Wann ist der Strompreis heute am günstigsten?</h3>
    <p>{heute ? `Heute ${heute.best.text}, im Schnitt ${fmt(heute.best.v)} ct/kWh an der Börse.` : 'Siehe Grafik oben.'} In der Regel mittags, wenn die Sonne scheint, im Winter nachts.</p>
    <h3>Wann kommen die Preise für morgen?</h3>
    <p>Die Day-Ahead-Auktion der EPEX Spot schließt um 12 Uhr, die Ergebnisse stehen gegen 13 Uhr fest. Anbieter-Apps zeigen sie meist zwischen 13 und 17 Uhr.</p>
    <h3>Ist das mein Strompreis?</h3>
    <p>Nein, das ist der Börsenanteil. Netzentgelte, Steuern, Umlagen und der Aufschlag des Anbieters kommen fest dazu, zusammen rund 19 bis 20 Cent brutto.</p>
    <h3>Woher kommen die Daten?</h3>
    <p>Von SMARD, der Datenplattform der Bundesnetzagentur, abgerufen über die Schnittstelle von energy-charts.info (Fraunhofer ISE). Die Seite wird
    automatisch neu erzeugt, es läuft kein Skript in deinem Browser und keine Anfrage an fremde Server.</p>
  </div>
</Base>

