const STUFE: Record<Stufe, { status: string; text: string; kurz: string; icon: string }> = {
  selbst: { status: 'gut', text: 'Kannst du selbst beheben', kurz: 'selbst machbar', icon: 'wrench' },
  teils: { status: 'achtung', text: 'Teils selbst, teils Fachbetrieb', kurz: 'teils selbst, teils Fachbetrieb', icon: 'triangle-alert' },
  fachbetrieb: { status: 'erhoeht', text: 'Fall für den Fachbetrieb', kurz: 'Fachbetrieb', icon: 'phone' },
  normal: { status: 'gut', text: 'Kein Fehler', kurz: 'kein Fehler', icon: 'circle-check' },
};

// Beim Bauen prüfen, dass jeder Weg irgendwo endet und jedes Ergebnis erreichbar ist.
const erreicht = new Set<string>();
for (const [id, f] of Object.entries(FRAGEN)) for (const o of f.optionen) {
  if (o.frage && !FRAGEN[o.frage]) throw new Error(`Heizungs-Diagnose: Frage ${o.frage} fehlt (${id}.${o.key})`);
  if (o.ergebnis && !ERGEBNISSE[o.ergebnis]) throw new Error(`Heizungs-Diagnose: Ergebnis ${o.ergebnis} fehlt (${id}.${o.key})`);
  if (o.ergebnis) erreicht.add(o.ergebnis);
}
for (const e of Object.keys(ERGEBNISSE)) if (!erreicht.has(e)) throw new Error(`Heizungs-Diagnose: Ergebnis ${e} ist nicht erreichbar`);

// Übersicht für alle ohne JavaScript und für die Suche: jeder Weg mit seinem Ergebnis.
type Zeile = { anzeichen: string; e: Ergebnis };
const gruppen: { titel: string; zeilen: Zeile[] }[] = [];
function sammeln(id: string, praefix: string[], zeilen: Zeile[], tiefe = 0) {
  for (const o of FRAGEN[id].optionen) {
    const weg = [...praefix, o.kurz ?? o.text];
    if (o.ergebnis) zeilen.push({ anzeichen: weg.join(': '), e: ERGEBNISSE[o.ergebnis] });
    else if (o.frage && tiefe < 2 && !(id === 'temperatur' && o.frage === 'einer')) sammeln(o.frage, weg, zeilen, tiefe + 1);
  }
}
for (const o of FRAGEN.start.optionen) {
  const zeilen: Zeile[] = [];
  sammeln(o.frage!, [], zeilen);
  gruppen.push({ titel: o.text, zeilen });
}
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap" data-pagefind-body data-pagefind-meta="thema:Heizung" style="--akzent:#ff741c">
    <nav class="crumbs" aria-label="Brotkrumen" data-pagefind-ignore><a href="/">Start</a> › <a href="/rechner/">Rechner</a> › Heizungs-Diagnose</nav>
    <h1>{title}</h1>
    <p class="lead">Heizkörper kalt, Heizung gluckert oder der Druck stimmt nicht? Beantworte bis zu drei kurze Fragen. Dann siehst du die
    wahrscheinliche Ursache, was du selbst tun kannst und wann der Fachbetrieb ran muss.</p>

    <section class="box calc diagnose" aria-label="Heizungs-Diagnose" data-pagefind-ignore>
      <input type="hidden" id="pfad" value="" />
      <div class="diag-fragen">
        {Object.entries(FRAGEN).map(([id, f]) => (
          <fieldset class="diag-frage" data-frage={id} hidden={id !== 'start'}>
            <legend>{f.frage}</legend>
            {f.hilfe && <p class="diag-hilfe">{f.hilfe}</p>}
            <div class={`diag-optionen${id === 'start' ? ' diag-start' : ''}`}>
              {f.optionen.map((o) => (
                <label class="diag-option">
                  <input type="radio" name={`f-${id}`} value={o.key} />
                  {o.icon && <Icon name={o.icon} size={22} />}
                  <span>{o.text}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
      <noscript><p class="small">Ohne JavaScript funktioniert die Diagnose nicht. Alle Ursachen stehen unten in der Übersicht.</p></noscript>

      <div class="diag-ergebnisse" aria-live="polite">
        {Object.entries(ERGEBNISSE).map(([id, e]) => (
          <div class="diag-ergebnis" data-ergebnis={id} hidden>
            <p class="duebel-typ"><span class="small">Wahrscheinliche Ursache</span><strong>{e.titel}</strong></p>
            <p class="taupunkt-status diag-stufe" data-status={STUFE[e.stufe].status}><Icon name={STUFE[e.stufe].icon} size={18} /> {STUFE[e.stufe].text}</p>
            <p>{e.ursache}</p>
            <p class="diag-h">So gehst du vor</p>
            <ol class="diag-schritte">{e.schritte.map((s) => <li>{s}</li>)}</ol>
            {e.miete && <p class="diag-miete"><strong>Mietwohnung:</strong> {e.miete}</p>}
            {e.produkt && (
              <p class="diag-produkt"><a class="btn btn-sm" href={amazonSearch(e.produkt[1])} rel="sponsored nofollow noopener" target="_blank">{e.produkt[0]} bei Amazon*</a>
              <span class="small">* Anzeige: Affiliate-Link, für dich ändert sich am Preis nichts.</span></p>
            )}
            <p class="diag-h">Ausführlich mit Bildern</p>
            <ul class="diag-links">{e.artikel.map(([href, text]) => <li><a href={href}>{text}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <p class="diag-neu" hidden><button type="button" class="btn btn-sm btn-ghost-dark" id="diag-neu"><Icon name="rotate-ccw" size={16} /> Neu starten</button></p>
      <RechnerTeilen />
    </section>
    <script type="application/json" id="diagnose-daten" set:html={JSON.stringify(Object.fromEntries(Object.entries(FRAGEN).map(([id, f]) => [id, f.optionen.map(({ key, frage, ergebnis }) => ({ key, frage, ergebnis }))])))} />

    {video && <VideoBox video={video} ueberschrift="Heizkörper wird nicht warm? Das Video dazu" />}

    <h2>Alle Anzeichen und Ursachen auf einen Blick</h2>
    <p>Die Diagnose fragt nach diesen Anzeichen. Hier stehen alle Wege mit der wahrscheinlichen Ursache und wer sie beheben kann.</p>
    {gruppen.map((g) => (
      <>
        <h3>{g.titel}</h3>
        <table class="diag-tabelle">
          <thead><tr><th scope="col">Anzeichen</th><th scope="col">Ursache und wer sie behebt</th></tr></thead>
          <tbody>{g.zeilen.map((z) => <tr><td>{z.anzeichen}</td><td><a href={z.e.artikel[0][0]}>{z.e.titel}</a><span class="diag-wer">{STUFE[z.e.stufe].kurz}</span></td></tr>)}</tbody>
        </table>
      </>
    ))}

    <h2>In dieser Reihenfolge prüfen</h2>
    <ol>
      <li><strong>Luft:</strong> Gluckert es oder ist der Heizkörper oben kalt, zuerst entlüften, mit ausgeschalteter Pumpe.</li>
      <li><strong>Ventilstift:</strong> Bleibt ein Heizkörper ganz kalt, den Thermostatkopf abnehmen und den Stift prüfen.</li>
      <li><strong>Thermostatkopf:</strong> Wird der Heizkörper nur ohne Kopf warm, den Kopf tauschen.</li>
      <li><strong>Druck:</strong> Manometer ablesen, im Einfamilienhaus meist 1 bis 2 bar, und bei Bedarf Wasser nachfüllen.</li>
      <li><strong>Fachbetrieb:</strong> Pumpe, hydraulischer Abgleich, Spülen und Störungen der Heizung.</li>
    </ol>
    <p>Die ersten drei Punkte kosten kaum etwas und lösen die meisten Fälle, in denen ein einzelner Heizkörper nicht warm wird.</p>

    <h2>Häufige Fragen</h2>
    <h3>Warum wird nur ein Heizkörper nicht warm?</h3>
    <p>Fast immer liegt es an genau diesem Heizkörper: Luft oder ein klemmender Ventilstift. Erst entlüften, dann den Stift prüfen.
    Werden mehrere oder alle nicht warm, steckt meist die Anlage dahinter, also Druck, Pumpe, Abgleich oder die Heizung selbst.</p>
    <h3>Welcher Druck ist bei der Heizung richtig?</h3>
    <p>Im Einfamilienhaus meist 1 bis 2 bar. Maßgeblich ist der grüne Bereich am Manometer bzw. die Anleitung deiner Heizung. Wie du
    nachfüllst: <a href="/artikel/heizung-wasser-nachfuellen/">Heizung Wasser nachfüllen</a>.</p>
    <h3>Ist eine gluckernde Heizung gefährlich?</h3>
    <p>Meist nicht, aber sie ist ein Warnzeichen für Luft oder zu wenig Druck. Fällt der Druck immer wieder oder tritt irgendwo Wasser
    aus, solltest du es vom Fachbetrieb prüfen lassen.</p>
    <h3>Was darf ich in der Mietwohnung selbst machen?</h3>
    <p>Heizkörper entlüften und den Ventilstift gängig machen ist in der Regel unproblematisch. Alles, was die Anlage betrifft (Druck,
    Pumpe, Abgleich, Heizkurve, Spülen), ist Sache des Vermieters.</p>

    <p class="small">Die Diagnose fasst die Heizungsanleitungen dieser Website zusammen. Die Quellen stehen jeweils in den verlinkten Artikeln.
    Sie ersetzt keinen Fachbetrieb: Bei Wasseraustritt, Gasgeruch oder Störungsmeldungen immer den Heizungsbauer rufen. Mit * markierte
    Links sind Affiliate-Links: Kaufst du darüber ein, bekomme ich eine kleine Provision, für dich ändert sich am Preis nichts.
    <a href="/werbung/">Mehr dazu</a></p>
  </div>
</Base>

<script>
  type Opt = { key: string; frage?: string; ergebnis?: string };
  const FRAGEN: Record<string, Opt[]> = JSON.parse(document.getElementById('diagnose-daten')?.textContent || '{}');
  const box = document.querySelector<HTMLElement>('.diagnose');
  const pfad = document.getElementById('pfad') as HTMLInputElement | null;
  const liste = box?.querySelector<HTMLElement>('.diag-fragen');
  const neu = box?.querySelector<HTMLElement>('.diag-neu');
  const frageEl = (id: string) => box?.querySelector<HTMLFieldSetElement>(`fieldset[data-frage="${id}"]`);

  // Den gespeicherten Weg (z. B. "einer.ganz-kalt.nein") ablaufen: welche Fragen sichtbar sind und welches Ergebnis gilt.
  function ablaufen(keys: string[]) {
    const fragen: string[] = [];
    let frage: string | undefined = 'start';
    let ergebnis: string | undefined;
    const gueltig: string[] = [];
    for (const k of keys) {
      if (!frage || fragen.includes(frage)) break;
      const opt: Opt | undefined = FRAGEN[frage]?.find((o) => o.key === k);
      if (!opt) break;
      fragen.push(frage);
      gueltig.push(k);
      if (opt.ergebnis) { ergebnis = opt.ergebnis; frage = undefined; break; }
      frage = opt.frage;
    }
    if (frage && FRAGEN[frage] && !fragen.includes(frage)) fragen.push(frage);
    return { fragen, ergebnis, gueltig };
  }

  function zeigen(scrollen = false) {
    if (!box || !pfad || !liste) return;
    const { fragen, ergebnis, gueltig } = ablaufen(pfad.value ? pfad.value.split('.') : []);
    pfad.value = gueltig.join('.');
    box.querySelectorAll<HTMLFieldSetElement>('fieldset[data-frage]').forEach((f) => { f.hidden = true; });
    fragen.forEach((id, i) => {
      const f = frageEl(id);
      if (!f) return;
      liste.append(f);
      f.hidden = false;
      f.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => { r.checked = r.value === gueltig[i]; });
    });
    box.querySelectorAll<HTMLElement>('[data-ergebnis]').forEach((e) => { e.hidden = e.dataset.ergebnis !== ergebnis; });
    if (neu) neu.hidden = gueltig.length === 0;
    if (!scrollen) return;
    const ziel = ergebnis ? box.querySelector<HTMLElement>(`[data-ergebnis="${ergebnis}"]`) : frageEl(fragen[fragen.length - 1]);
    const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    ziel?.scrollIntoView({ behavior: reduziert ? 'auto' : 'smooth', block: 'nearest' });
  }

  box?.addEventListener('change', (ev) => {
    const r = ev.target;
    if (!(r instanceof HTMLInputElement) || r.type !== 'radio' || !pfad) return;
    const id = r.closest<HTMLFieldSetElement>('fieldset[data-frage]')?.dataset.frage;
    if (!id) return;
    const { fragen, gueltig } = ablaufen(pfad.value ? pfad.value.split('.') : []);
    const pos = fragen.indexOf(id);
    if (pos < 0) return;
    pfad.value = [...gueltig.slice(0, pos), r.value].join('.');
    zeigen(true);
  });
  // RechnerTeilen setzt #pfad aus dem Link und meldet das per input/change.
  pfad?.addEventListener('change', () => zeigen());
  document.getElementById('diag-neu')?.addEventListener('click', () => {
    if (!pfad) return;
    pfad.value = '';
    zeigen();
    frageEl('start')?.querySelector<HTMLInputElement>('input')?.focus();
    box?.scrollIntoView({ block: 'nearest' });
  });
  zeigen();
</script>
