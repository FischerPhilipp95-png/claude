---
// Kompakter Kasten direkt nach der Antwort: „Das brauchst du“. Höchste Klickrate, weil die
// Leser an dieser Stelle schon wissen, dass sie das Werkzeug brauchen.
import { amazonSearch } from '../site';
import Icon from './Icon.astro';
interface Item { name: string; warum: string; suche: string }
interface Props { titel?: string; items: Item[] }
const { titel = 'Das brauchst du', items } = Astro.props;
---
<aside class="box quick" aria-label={titel} data-pagefind-ignore>
  <p class="quick-title"><Icon name="wrench" size={18} /> {titel}</p>
  <ul>
    {items.map((i) => (
      <li>
        <span><strong>{i.name}</strong><br /><span class="small">{i.warum}</span></span>
        <a class="btn btn-sm" href={amazonSearch(i.suche)} rel="sponsored nofollow noopener" target="_blank"><Icon name="shopping-cart" size={16} /> Preis prüfen*</a>
      </li>
    ))}
  </ul>
  <p class="small">*Affiliate-Links zu Amazon. Für dich ändert sich am Preis nichts.</p>
</aside>
