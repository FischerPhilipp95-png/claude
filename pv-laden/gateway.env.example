# Nach gateway.env kopieren und ausfüllen. gateway.env nie ins Repo legen (Schlüssel!).

# Aus "python -m tinytuya wizard" (siehe README, Schritt 4)
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
# Feste IP der Wallbox (in der FRITZ!Box "immer dieselbe IP zuweisen" anhaken)
TUYA_IP=192.168.178.
TUYA_VERSION=3.3

BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8087

# Erlaubter Ladestrom in Ampere.
# An der roten CEE-Dose: 6 bis 16. Am Schuko-Adapter: MAX auf 10 stellen!
TUYA_MIN_CURRENT=6
TUYA_MAX_CURRENT=16

# 3 = rote CEE-Dose (3-phasig), 1 = Schuko-Adapter (1-phasig).
# Die Wallbox meldet das nicht zuverlässig, deshalb hier von Hand.
TUYA_NUM_PHASES=3

# Zeitplan der dé-App automatisch abschalten, damit nur evcc steuert
TUYA_DISABLE_SCHEDULE=true
TUYA_SCHEDULE_CHECK_INTERVAL=60
