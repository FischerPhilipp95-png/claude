---
import Base from './Base.astro';
import { SITE } from '../site';
import { THEMEN, type Thema } from '../themen';
import Verwandt from '../components/Verwandt.astro';
import Icon from '../components/Icon.astro';
import PinterestMerken from '../components/PinterestMerken.astro';
import Geprueft from '../components/Geprueft.astro';
import { videoFuerArtikel, videoSchema } from '../videos';
import { CHECKLISTEN } from '../checklisten.mjs';
import { existsSync } from 'node:fs';
import { maschine } from '../maschinen';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  thema: string;
  bild: string;
  affiliate: boolean;
  id: string;
  headings: { depth: number; slug: string; text: string }[];
  bildAlt: string;
  lesezeit: number;
  maschinen?: string[];
  pruefung?: { datum: Date; anleitung: string; videos: number; reddit: number; korrektur?: string };
}
const { title, description, pubDate, updatedDate, thema, bild, affiliate, id, headings, bildAlt, lesezeit, maschinen = [], pruefung } = Astro.props;
const passtZu = maschinen.map((m) => ({ id: m, ...maschine(m) }));
const akzent = THEMEN[thema as Thema].farbe;
const themaIcon = THEMEN[thema as Thema].icon;
const themaSlug = THEMEN[thema as Thema].slug;
const themaTitel = THEMEN[thema as Thema].titel;
const toc = headings.filter((h) => h.depth === 2 && h.text !== 'Quellen');
const url = new URL(Astro.url.pathname, SITE.url).toString();
const datum = (d: Date) => d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
// Hochformat-Pin (scripts/pins.mjs): Wer den Artikel bei Pinterest merkt, bekommt dieses Bild statt des breiten Titelbilds.
const pin = existsSync(`public/bilder/pins/${id}.jpg`) ? `${SITE.url}/bilder/pins/${id}.jpg` : new URL(bild, SITE.url).toString();
const video = videoFuerArtikel(id);
const checklisten = CHECKLISTEN.filter((c) => c.artikel.includes(id));
const person = { '@type': 'Person', name: SITE.author, url: `${SITE.url}/ueber/`, sameAs: [SITE.youtube] };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: [new URL(bild, SITE.url).toString()],
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: person,
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/bilder/autor.webp` } },
    mainEntityOfPage: url,
    inLanguage: 'de-DE',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: themaTitel, item: `${SITE.url}/thema/${themaSlug}/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
const vSchema = video && videoSchema(video, description);
if (vSchema) jsonLd.push(vSchema as any);
---
<Base title={title} description={description} image={bild} jsonLd={jsonLd} type="article" artikel={{ veroeffentlicht: pubDate, geaendert: updatedDate, rubrik: themaTitel }}>
  <article class="wrap article" style={`--akzent:${akzent}`} data-pagefind-body>
    <nav class="crumbs" aria-label="Brotkrumen" data-pagefind-ignore><a href="/">Start</a> <Icon name="chevron-right" size={14} /> <a href={`/thema/${themaSlug}/`}>{themaTitel}</a></nav>
    <a class="chip chip-lg" href={`/thema/${themaSlug}/`} data-pagefind-meta="thema" data-pagefind-ignore><Icon name={themaIcon} size={16} /> {themaTitel}</a>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="byline" data-pagefind-ignore>
      <img src="/bilder/autor.webp" alt="" width="40" height="40" data-pin-nopin="true" />
      <span><strong>{SITE.author}</strong><br /><span class="small">{updatedDate ? `Aktualisiert am ${datum(updatedDate)}` : `Veröffentlicht am ${datum(pubDate)}`} · <Icon name="clock" size={13} /> {lesezeit} Min. Lesezeit</span></span>
    </div>
    {passtZu.length > 0 && (
      <p class="passt-zu" data-pagefind-ignore><strong>Passt zu:</strong> {passtZu.map((m) => <a class="chip" href={`/maschine/${m.id}/`}>{THEMEN[m.hersteller as Thema].titel.split(' ')[0]} {m.name}</a>)}</p>
    )}
    <figure class="hero-img"><img data-pagefind-meta="image[src], image_alt[alt]" src={bild} alt={bildAlt} width="1200" height="675" fetchpriority="high" decoding="async" data-pin-media={pin} data-pin-description={`${title}: ${description}`} data-pin-url={url} /></figure>
    {affiliate && (
      <p class="ad-note" data-pagefind-ignore><strong>Anzeige:</strong> Dieser Artikel enthält Affiliate-Links (mit * markiert). Kaufst du darüber ein,
      bekomme ich eine kleine Provision, für dich ändert sich am Preis nichts. <a href="/werbung/">Mehr dazu</a></p>
    )}
    {toc.length >= 3 && (
      <details class="toc" data-pagefind-ignore>
        <summary><Icon name="list-checks" size={18} /> Inhalt dieses Artikels</summary>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <slot />
    {checklisten.map((c) => (
      <aside class="box druck-checkliste" aria-label={`Checkliste zum Ausdrucken: ${c.kurz}`} data-pagefind-ignore>
        <Icon name="printer" size={28} />
        <p><strong>Checkliste zum Ausdrucken:</strong> {c.titel}. Als PDF, kostenlos, mit QR-Code zu dieser Anleitung.</p>
        <a class="btn btn-sm" href={`/checklisten/${c.id}/`}>Zur Checkliste</a>
      </aside>
    ))}
    {pruefung && <Geprueft pruefung={pruefung} />}
    <PinterestMerken url={url} bild={pin} text={`${title}: ${description}`} />
    <div data-pagefind-ignore><Verwandt id={id} thema={thema} /></div>
    <section class="box author" aria-label="Über den Autor" data-pagefind-ignore>
      <img src="/bilder/autor.webp" alt={SITE.author} width="64" height="64" loading="lazy" data-pin-nopin="true" />
      <p><strong>{SITE.author}</strong> erklärt auf <a href={SITE.youtube} rel="noopener">YouTube</a> und hier im Blog,
      wie du deinen Kaffeevollautomaten pflegst und kleine Fehler selbst behebst, Schritt für Schritt nach den Herstellerangaben.
      Die Videos kommen vom Kanal „{SITE.kanal}“. {' '}<a href="/ueber/">Mehr über den Vollautomaten-Doktor</a></p>
    </section>
  </article>
</Base>
