---
// Zwei-Klick-Lösung: Erst nach Klick wird YouTube (youtube-nocookie.com) geladen.
// Das Vorschaubild muss ein eigenes Bild vom eigenen Server sein (z. B. das Video-Thumbnail).
interface Props { id: string; titel: string; vorschau: string }
const { id, titel, vorschau } = Astro.props;
---
<div class="video" data-yt={id} data-title={titel}>
  <img src={vorschau} alt={`Vorschau: ${titel}`} loading="lazy" width="1280" height="720" data-pin-nopin="true" />
  <button class="load" type="button"><span class="play">▶ Video laden</span><span class="sr-only">: {titel}</span></button>
</div>
<p class="video-hinweis">Beim Laden werden Daten an YouTube (Google) übertragen, u. a. deine IP-Adresse. Mehr in der <a href="/datenschutz/">Datenschutzerklärung</a> (Nr. 7).</p>
<script>
  document.querySelectorAll<HTMLElement>('.video[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', (e) => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      f.title = box.dataset.title || 'YouTube-Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(f);
    });
  });
</script>
