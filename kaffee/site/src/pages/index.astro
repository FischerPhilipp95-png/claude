---
import SuchFeld from '../components/SuchFeld.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArtikelFeature from '../components/ArtikelFeature.astro';
import ArtikelZeile from '../components/ArtikelZeile.astro';
import VideoKarte from '../components/VideoKarte.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { THEMEN, type Thema } from '../themen';
import { themenBild, PRODUKTE_BILD } from '../themen-bilder';
import { SAISON } from '../saison';
import { mediathekVideos } from '../videos';
import { maschinenListe } from '../maschinen-hilfe';

const posts = (await getCollection('artikel', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const anzahl = (name: string) => posts.filter((p) => p.data.thema === name).length;
const videoAnzahl = (name: string) => mediathekVideos(name).length;
const alleVideos = (Object.keys(THEMEN) as Thema[]).reduce((n, k) => n + videoAnzahl(k), 0) + mediathekVideos('Weitere').length;
const saison = SAISON.artikel.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined);
const neueste = posts.filter((p) => !SAISON.artikel.includes(p.id)).slice(0, 5);
const kacheln = (Object.entries(THEMEN) as [Thema, (typeof THEMEN)[Thema]][]).filter(([n]) => anzahl(n) + videoAnzahl(n) > 0)
  .map(([n, t]) => ({ n, t, bild: themenBild(n, t.slug) }));
const neueVideos = mediathekVideos('DeLonghi').slice(1, 4);
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/`, inLanguage: 'de-DE' }];
---
<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap wide">
      <h1 class="hero-h" id="hero-h"><span class="line"><span>Vollautomat,</span></span><span class="line"><span>einfach erklärt.</span></span></h1>
    </div>
    <div class="hero-band">
      <div class="hero-band-grid">
        <div class="hero-copy">
          <p class="hero-lead"><span>Rote Lampe blinkt?</span> <span>Milchschaum kommt nicht?</span> <span>Kaffee schmeckt wässrig?</span></p>
          <p class="hero-sub">Entkalken, reinigen, Filter wechseln: die Lösung für dein Modell, Schritt für Schritt nach Herstellerangaben.</p>
          <SuchFeld id="suche-start" variante="hero" />
          <div class="hero-cta">
            <a class="btn" href="/maschinen/"><Icon name="coffee" size={16} /> Meine Maschine finden</a>
            <a class="btn btn-ghost" href="/rechner/vollautomat-diagnose/"><Icon name="stethoscope" size={16} /> Was hat meine Maschine?</a>
          </div>
        </div>
        <img class="hero-person" src="/bilder/vollautomatendoktor-freisteller.webp" alt={SITE.author} width="900" height="900" fetchpriority="high" decoding="async" data-pin-nopin="true" />
        <p class="hero-facts"><span>{posts.length} Anleitungen</span><span>{alleVideos} Videos</span><span>{maschinenListe().length} Maschinen</span><span>Nach Herstellerangaben</span></p>
      </div>
    </div>
  </section>

  <section class="wrap wide" aria-labelledby="marken-h">
    <h2 class="section-h" id="marken-h">Welche Marke hast du?</h2>
    <ul class="tiles tiles-foto">
      {kacheln.map(({ n, t, bild }) => (
        <li><a href={`/thema/${t.slug}/`} style={`--akzent:${t.farbe}`}>
          <img class="tile-foto" src={bild.klein} srcset={`${bild.klein} 480w, ${bild.src} 960w`} sizes="(max-width: 600px) 50vw, 240px"
            alt={bild.alt} width="480" height="360" loading="lazy" decoding="async" />
          <span class="tile-name">{t.titel}</span>
          <span class="tile-count">{anzahl(n)} {anzahl(n) === 1 ? 'Anleitung' : 'Anleitungen'}{videoAnzahl(n) ? `, ${videoAnzahl(n)} ${videoAnzahl(n) === 1 ? 'Video' : 'Videos'}` : ''}</span>
        </a></li>
      ))}
      <li><a href="/produkte/" style="--akzent:#d08a3a">
        <img class="tile-foto" src="/bilder/marken/produkte-klein.webp" srcset="/bilder/marken/produkte-klein.webp 480w, /bilder/marken/produkte.webp 960w"
          sizes="(max-width: 600px) 50vw, 240px" alt={PRODUKTE_BILD.alt} width="480" height="360" loading="lazy" decoding="async" />
        <span class="tile-name">Entkalker &amp; Filter</span>
        <span class="tile-count">Welches Mittel passt zu deiner Maschine?</span>
      </a></li>
    </ul>
    <p class="bildnachweise">Fotos: {kacheln.map(({ t, bild }) => <span><b>{t.titel}:</b> <Fragment set:html={bild.nachweis.replace(/^Foto: /, '')} /></span>)}
      <span><b>Entkalker &amp; Filter:</b> <Fragment set:html={PRODUKTE_BILD.nachweis.replace(/^Foto: /, '')} /></span></p>
  </section>

  <section class="wrap wide saison" aria-labelledby="saison-h">
    <h2 class="section-h" id="saison-h">{SAISON.titel}</h2>
    <p class="saison-text">{SAISON.text}</p>
    <div class="feature-grid">
      {saison[0] && <ArtikelFeature post={saison[0]} />}
      <ul class="tiles tiles-liste" aria-label="Weitere häufig gesuchte Anleitungen">{saison.slice(1).map((p) => <ArtikelZeile post={p} />)}</ul>
    </div>
  </section>

  <section class="wrap wide" aria-labelledby="video-h">
    <h2 class="section-h" id="video-h">De’Longhi im Video</h2>
    <ul class="cards">{neueVideos.map((v) => <VideoKarte video={v} farbe={THEMEN.DeLonghi.farbe} />)}</ul>
    <p class="center"><a class="btn btn-dark" href="/videos/">Alle {alleVideos} Video-Anleitungen <Icon name="chevron-right" size={18} /></a></p>
  </section>

  <section class="wrap wide" aria-labelledby="neu-h">
    <h2 class="section-h" id="neu-h">Neueste Anleitungen</h2>
    <ul class="tiles tiles-liste">{neueste.map((p) => <ArtikelZeile post={p} />)}</ul>
    <p class="center"><a class="btn btn-dark" href="/artikel/">Alle {posts.length} Anleitungen ansehen <Icon name="chevron-right" size={18} /></a></p>
  </section>
</Base>
