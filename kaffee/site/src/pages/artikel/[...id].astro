---
import { getCollection, render } from 'astro:content';
import Artikel from '../../layouts/Artikel.astro';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.entwurf);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const woerter = (post.body ?? '').replace(/<[^>]+>|\{[^}]*\}/g, ' ').split(/\s+/).filter(Boolean).length;
const lesezeit = Math.max(1, Math.round(woerter / 200));
---
<Artikel title={d.title} description={d.description} pubDate={d.pubDate} updatedDate={d.updatedDate} thema={d.thema} bild={d.bild} affiliate={d.affiliate} id={post.id} headings={headings} bildAlt={d.bildAlt} lesezeit={lesezeit}>
  <Content />
</Artikel>
