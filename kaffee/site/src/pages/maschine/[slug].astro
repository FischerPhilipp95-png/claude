---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtikelKarte from '../../components/ArtikelKarte.astro';
import VideoKarte from '../../components/VideoKarte.astro';
import Icon from '../../components/Icon.astro';
import Schnellkauf from '../../components/Schnellkauf.astro';
import { pflegemittelFuer } from '../../pflegemittel';
import { SITE } from '../../site';
import Bild from '../../components/Bild.astro';
import { maschinenBild } from '../../maschinen-bilder';
import { maschinenListe, beitraegeFuer, allgemeineFuer, videosFuer, hatInhalt, pruefeZuordnung } from '../../maschinen-hilfe';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.entwurf);
  pruefeZuordnung(posts);
  return maschinenListe().map((m) => ({ params: { slug: m.id }, props: { m, posts } }));
}
const { m, posts } = Astro.props;
const eigene = beitraegeFuer(m.id, posts);
const allgemein = allgemeineFuer(m, posts);
const videos = videosFuer(m);
const geschwister = maschinenListe().filter((x) => x.hersteller === m.hersteller && x.id !== m.id);
// Ohne eigenen Beitrag und ohne Video: Seite für Besucher da, aber nicht für Google (keine dünnen Seiten im Index).
const leer = !hatInhalt(m, posts);
const bild = maschinenBild(m.id);
const marke = m.markenname ?? m.marke.titel.split(' ')[0];
const kauf = [
  ...pflegemittelFuer(marke),
  { name: `Neue ${m.titel}?`, warum: 'Aktuelle Preise und Varianten bei Amazon vergleichen.', suche: `${marke.replace('’', "'")} ${m.name} ${m.art === 'siebtraeger' ? 'Siebträger' : 'Kaffeevollautomat'}` },
];
const title = `${m.titel}: Anleitungen und Hilfe`;
const description = `${m.titel}: entkalken, reinigen, Fehler beheben. Alle Anleitungen und Videos für deine Maschine an einem Ort.`;
const url = `${SITE.url}/maschine/${m.id}/`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url, inLanguage: 'de-DE',
    // Kein „Product“: Google verlangt dafür Preis (offers) oder Bewertungen, die wir nicht haben -> Fehler in der Search Console.
    about: { '@type': 'Thing', name: m.titel } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Maschinen', item: `${SITE.url}/maschinen/` },
    { '@type': 'ListItem', position: 3, name: m.marke.titel, item: `${SITE.url}/thema/${m.marke.slug}/` },
    { '@type': 'ListItem', position: 4, name: m.name, item: url },
  ] },
];
---
<Base title={title} description={description} jsonLd={jsonLd} noindex={leer} image={bild?.src}>
  <div class="wrap wide" style={`--akzent:${m.marke.farbe}`}>
    <nav class="crumbs" aria-label="Brotkrumen"><a href="/">Start</a> › <a href="/maschinen/">Maschinen</a> › <a href={`/thema/${m.marke.slug}/`}>{m.marke.titel}</a> › {m.name}</nav>
    <a class="chip chip-lg" href={`/thema/${m.marke.slug}/`}><Icon name={m.marke.icon} size={16} /> {m.marke.titel}</a>
    <div class={bild ? 'thema-kopf' : undefined}>
      <div>
        <h1>{m.titel}: Anleitungen und Hilfe</h1>
        <p class="lead">Alles für deine {m.titel} an einem Ort: Anleitungen zum Nachlesen, Videos und die Pflege-Grundlagen,
        die für alle {m.marke.titel}-Maschinen gelten.{m.art === 'siebtraeger' ? ' Hinweis: Das ist ein Siebträger, kein Vollautomat.' : ''}</p>
      </div>
      {bild && <Bild src={bild.src} alt={bild.alt} nachweis={bild.nachweis} width={960} height={720} eager />}
    </div>

    {leer && (
      <aside class="box in-arbeit" aria-label="Anleitungen in Arbeit">
        <p><strong>Für die {m.titel} entstehen die Anleitungen gerade.</strong> Bis dahin helfen dir die Grundlagen unten:
        Sie gelten für alle {m.marke.titel}-Maschinen. Maßgeblich ist immer die Bedienungsanleitung deines Geräts.</p>
        <p class="small">Welches Problem hast du mit deiner {m.name}? <a href="/kontakt/">Schreib es mir</a>, dann kommt diese Anleitung zuerst.</p>
      </aside>
    )}
    <p class="ad-note"><strong>Anzeige:</strong> Diese Seite enthält Affiliate-Links (mit * markiert). Kaufst du darüber ein,
    bekomme ich eine kleine Provision, für dich ändert sich am Preis nichts. <a href="/werbung/">Mehr dazu</a></p>
    <Schnellkauf titel={`Pflege für deine ${m.name}`} items={kauf} />
    {eigene.length > 0 && (
      <section aria-labelledby="eigene-h">
        <h2 class="section-h" id="eigene-h">Anleitungen für die {m.name}</h2>
        <ul class="cards">{eigene.map((p) => <ArtikelKarte post={p} />)}</ul>
      </section>
    )}
    {videos.length > 0 && (
      <section aria-labelledby="videos-h">
        <h2 class="section-h" id="videos-h">{m.name} im Video</h2>
        <ul class="cards">{videos.map((v) => <VideoKarte video={v} farbe={m.marke.farbe} />)}</ul>
      </section>
    )}
    {allgemein.length > 0 && (
      <section aria-labelledby="allg-h">
        <h2 class="section-h" id="allg-h">Gilt auch für deine {m.name}</h2>
        <ul class="cards">{allgemein.map((p) => <ArtikelKarte post={p} />)}</ul>
      </section>
    )}
    {geschwister.length > 0 && (
      <section aria-labelledby="andere-h">
        <h2 class="section-h" id="andere-h">Andere {m.marke.titel}-Maschinen</h2>
        <p class="sprung">{geschwister.map((x) => <a class="chip" href={`/maschine/${x.id}/`}>{x.name}</a>)}</p>
      </section>
    )}
    <p class="small">Deine Maschine fehlt oder du hast ein anderes Problem? <a href="/kontakt/">Schreib mir</a>, dann kommt die Anleitung dazu.</p>
  </div>
</Base>
