---
// Kompakter Kasten direkt nach der Antwort: „Das brauchst du“ mit Links zu Partnershops (src/affiliate-links.ts).
import { shopLink, istPlatzhalter } from '../affiliate-links';
import Icon from './Icon.astro';
interface Item { name: string; warum: string; shop: string; produkt?: string }
interface Props { titel?: string; items: Item[] }
const { titel = 'Das brauchst du', items } = Astro.props;
---
<aside class="box quick" aria-label={titel} data-pagefind-ignore>
  <p class="quick-title"><Icon name="wrench" size={18} /> {titel}</p>
  <ul>
    {items.map((i) => { const href = shopLink(i.shop, i.produkt); return (
      <li>
        <span><strong>{i.name}</strong><br /><span class="small">{i.warum}</span></span>
        <a class="btn btn-sm" href={href} rel="sponsored nofollow noopener" target="_blank" data-affiliate={istPlatzhalter(href) ? 'offen' : undefined}><Icon name="shopping-cart" size={16} /> Zum Shop*</a>
      </li>
    ); })}
  </ul>
  <p class="small">*Affiliate-Links zu Partnershops. Für dich ändert sich am Preis nichts.</p>
</aside>
