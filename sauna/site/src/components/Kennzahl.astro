---
// Eine große Zahl aus dem Beitrag (z. B. „13,5 kWh je Saunagang“), mit Einheit, Bedeutung und Quelle.
// Nur für belegte Zahlen (Hersteller, Behörde, Verband). Die Quelle gehört immer dazu.
interface Props { wert: string; einheit?: string; text: string; quelle: string; quelleUrl?: string }
const { wert, einheit, text, quelle, quelleUrl } = Astro.props;
---
<figure class="kennzahl" role="group" aria-label={`${wert} ${einheit ?? ''}: ${text}`}>
  <span class="kennzahl-wert">{wert}{einheit && <small>{einheit}</small>}</span>
  <span class="kennzahl-text">{text}</span>
  <figcaption class="kennzahl-quelle">Quelle: {quelleUrl ? <a href={quelleUrl} rel="noopener">{quelle}</a> : quelle}</figcaption>
</figure>
