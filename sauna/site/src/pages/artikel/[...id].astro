---
import { getCollection, render } from 'astro:content';
import Artikel from '../../layouts/Artikel.astro';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.entwurf);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const woerter = (post.body ?? '').replace(/<[^>]+>|\{[^}]*\}/g, ' ').split(/\s+/).filter(Boolean).length;
const lesezeit = Math.max(1, Math.round(woerter / 200));
// FAQ für die FAQPage-Auszeichnung (Briefing Abschnitt 6): Abschnitt „## Häufige Fragen“, jede Frage als „### …“, Antwort als Absatz darunter.
const faqTeil = (post.body ?? '').split(/^## Häufige Fragen\s*$/m)[1]?.split(/^## /m)[0] ?? '';
const faq = faqTeil.split(/^### /m).slice(1).map((block) => {
  const [frage, ...rest] = block.split('\n');
  const antwort = rest.join(' ').replace(/<[^>]+>/g, ' ').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*_`]/g, '').replace(/\s+/g, ' ').trim();
  return { frage: frage.trim(), antwort };
}).filter((f) => f.frage && f.antwort);
---
<Artikel title={d.title} description={d.description} pubDate={d.pubDate} updatedDate={d.updatedDate} thema={d.thema} bild={d.bild} affiliate={d.affiliate} id={post.id} headings={headings} bildAlt={d.bildAlt} lesezeit={lesezeit} rechtshinweis={d.rechtshinweis} faq={faq} pruefung={d.pruefung}>
  <Content />
</Artikel>
