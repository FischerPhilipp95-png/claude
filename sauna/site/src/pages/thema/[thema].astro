---
import ArtikelKarte from '../../components/ArtikelKarte.astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Bild from '../../components/Bild.astro';
import { THEMEN } from '../../themen';
import { SITE } from '../../site';
import { RECHNER } from '../../rechner';
import { PRODUKTE, GRUPPEN, type Gruppe, type ProduktId } from '../../produkte';
import AmazonProdukt from '../../components/AmazonProdukt.astro';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.entwurf);
  // Alle vier Bereiche bekommen eine Seite (sie stehen im Menü). Ohne eigenen Beitrag: noindex, keine dünnen Seiten im Index.
  return Object.entries(THEMEN)
    .map(([name, t]) => ({ params: { thema: t.slug }, props: { name, t, posts: posts.filter((p) => p.data.thema === name) } }));
}
const { name, t, posts } = Astro.props;
const liste = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const rechner = RECHNER.filter((r) => r.thema === name);
// Bereich „Öfen & Zubehör“: alle Amazon-Produkte aus src/produkte.ts, nach Gruppen.
const produktGruppen = name === 'Zubehoer'
  ? (Object.keys(GRUPPEN) as Gruppe[]).map((g) => ({ g, titel: GRUPPEN[g], ids: (Object.keys(PRODUKTE) as ProduktId[]).filter((id) => PRODUKTE[id].gruppe === g) })).filter((x) => x.ids.length > 0)
  : [];
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${t.titel}: Ratgeber`,
  url: `${SITE.url}/thema/${t.slug}/`, inLanguage: 'de-DE',
  hasPart: liste.map((p) => ({ '@type': 'Article', headline: p.data.title, url: `${SITE.url}/artikel/${p.id}/` })),
}];
---
<Base title={`${t.titel}: Ratgeber`} description={t.intro.slice(0, 155)} jsonLd={jsonLd} image={`/bilder/bereiche/${t.slug}.webp`} noindex={posts.length === 0}>
  <div class="wrap wide" style={`--akzent:${t.farbe}`}>
    <nav class="crumbs" aria-label="Brotkrumen"><a href="/">Start</a> › {t.titel}</nav>
    <div class="thema-kopf">
      <div>
        <h1>{t.titel}</h1>
        <p class="lead">{t.intro}</p>
      </div>
      <Bild src={`/bilder/bereiche/${t.slug}.webp`} alt={t.bild} nachweis="Bild: KI-generiert für den Gartensauna-Doktor" width={960} height={720} eager />
    </div>
    {liste.length > 0
      ? <section aria-labelledby="artikel-h">
          <h2 class="section-h" id="artikel-h">Ratgeber</h2>
          <ul class="cards">{liste.map((p) => <ArtikelKarte post={p} />)}</ul>
        </section>
      : <p>Die Ratgeber zu diesem Bereich sind in Arbeit. Schau in der <a href="/artikel/">Übersicht aller Ratgeber</a> nach, was schon da ist.</p>}
    {produktGruppen.length > 0 && (
      <section aria-labelledby="produkte-h" class="produkte">
        <h2 class="section-h" id="produkte-h">Bei Amazon</h2>
        <p class="ad-note" data-pagefind-ignore><strong>Anzeige:</strong> Die Buttons sind Affiliate-Links zu Amazon (mit * markiert). Als Amazon-Partner verdiene ich
        an qualifizierten Verkäufen, für dich ändert sich am Preis nichts. Wir haben die Produkte nicht getestet. Die Angaben stammen von Herstellern
        und Händlern, Preise siehst du direkt bei Amazon. <a href="/werbung/">Mehr dazu</a></p>
        {produktGruppen.map(({ g, titel, ids }) => (
          <>
            <h3 id={`gruppe-${g}`}>{titel}</h3>
            <div class="produkt-raster">{ids.map((id) => <AmazonProdukt id={id} />)}</div>
          </>
        ))}
      </section>
    )}
    {rechner.length > 0 && (
      <section aria-labelledby="rechner-h">
        <h2 class="section-h" id="rechner-h">Rechner</h2>
        <ul class="tiles rechner-tiles">
          {rechner.map((r) => (
            <li><a href={r.href} style={`--akzent:${r.farbe}`}>
              <span class="tile-icon"><Icon name={r.icon} size={28} /></span>
              <span class="tile-name">{r.titel}</span>
              <span class="tile-count">{r.text}</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
